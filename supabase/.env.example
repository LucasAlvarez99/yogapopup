# Secretos del BACKEND (Edge Functions). NUNCA van en el frontend ni en Git con valores reales.
# Cargarlos con:  supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solos
# en las Edge Functions: no hay que cargarlos.

# --- Cloudflare R2 (Cloudflare dashboard > R2 > tu bucket) ---
# Cloudflare dashboard > R2 > Overview: "Account ID"
R2_ACCOUNT_ID=
# R2 > Manage API Tokens > crear un token con permiso de Object Read & Write, SOLO sobre
# el bucket de videos (no "Admin Read & Write" de toda la cuenta).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket (ej: yogapopup-videos)
R2_BUCKET=

# --- App ---
# Orígenes que pueden llamar a las funciones desde el navegador, separados por coma.
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
# Opcionales (valores por defecto entre paréntesis)
# PLAYBACK_TTL_SECONDS=7200   (2 h: duración de la URL firmada de reproducción)
# UPLOAD_TTL_SECONDS=14400    (4 h: ventana para terminar una subida)

# --- PayPal (fases 17-22) ---  Guía completa: docs/PAYPAL.md
# Son OPCIONALES: sin ellas el sitio funciona, pero la tienda y las suscripciones no cobran.
# developer.paypal.com > Apps & Credentials > (Sandbox | Live) > tu app.  El SECRETO va solo acá, nunca en js/config.js.
# sandbox = pruebas sin dinero real. Pasá a live recién cuando la checklist de docs/PAYPAL.md esté completa.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook: lo imprime  npm run paypal:webhook -- --url https://TU-PROYECTO.supabase.co/functions/v1/paypal-webhook
PAYPAL_WEBHOOK_ID=
# Id del plan de suscripción: lo imprime  npm run paypal:plan -- --price 9,99
PAYPAL_PLAN_ID=
# Opcionales
# PAYPAL_BRAND_NAME=Yoga Pop Up        (nombre que ve la persona en PayPal)
# RECONCILE_CRON_SECRET=               (secreto largo y aleatorio para que un cron dispare la conciliación; ver docs/PAYPAL.md)
