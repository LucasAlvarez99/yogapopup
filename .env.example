# Variables para las HERRAMIENTAS locales (CLI de Supabase). NO son secretos del backend.
# Copiar a ".env" y completar. ".env" está en .gitignore: nunca se sube a Git.

# Identificador del proyecto: Supabase > Project Settings > General > "Reference ID"
SUPABASE_PROJECT_REF=

# Opcionales. Si usás `npm run sb:login` (recomendado) no hacen falta.
# SUPABASE_ACCESS_TOKEN=     # supabase.com/dashboard/account/tokens (para CI/scripts)
# SUPABASE_DB_PASSWORD=      # contraseña de la base que definiste al crear el proyecto
